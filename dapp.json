{
  "name": "Musik Dunia",
  "description": "Buat musik semua genre, dari pop sampai musik daerah dunia, dibantu AI",
  "icon": { "image": "brand/icon.png", "emoji": "🎶" },
  "llm": {
    "purpose": "Menulis draf lirik lagu sesuai tema, suasana, dan bahasa pilihanmu",
    "suggested_daily_cap_cents": 50
  },
  "secrets": [],
  "tests": [
    {
      "id": "home.templates",
      "name": "Beranda menampilkan templat siap putar",
      "path": "/",
      "expectSelector": "#templateGrid [data-a=\"useTemplate\"][data-v=\"t-reggaegamelan\"]",
      "expectText": "Templat siap putar",
      "visual": true,
      "impact": ["public/index.html"]
    },
    {
      "name": "Kartu templat punya tag suasana dan tombol Dengar",
      "path": "/",
      "expectSelector": "#templateGrid [data-a=\"prevTemplate\"][data-v=\"t-pop\"]",
      "expectText": "Dengar",
      "visual": true,
      "impact": ["public/index.html"]
    },
    {
      "name": "Bilah atas punya tombol Simpan",
      "path": "/",
      "expectSelector": "header.top #btnSave[data-a=\"saveSong\"]"
    },
    {
      "name": "Beranda punya tombol Acak untuk memutar gaya acak",
      "path": "/",
      "expectSelector": "#shufflePanel #btnShuffle[data-a=\"shuffle\"]",
      "expectText": "Gaya acak"
    },
    {
      "name": "Halaman Belajar memuat istilah dan daftar budaya",
      "path": "/#belajar",
      "expectText": "Tentang budaya"
    },
    {
      "name": "Halaman Tentang Budaya Bugis & Makassar",
      "path": "/#budaya/bugis",
      "expectText": "Variasi antardaerah banyak, periksa dengan pelaku budaya setempat."
    }
  ]
}
